+    <arg name="route_control_scoring" value="$(eval False if arg('legacy_control') else arg('route_control_scoring'))"/>
+    <arg name="run_report" value="$(arg log_dir)/run_report.json"/>
+    <arg name="cycle_log" value="$(arg log_dir)/cycles.jsonl"/>
+    <arg name="output" value="$(arg log_dir)/planned_course.csv"/>
