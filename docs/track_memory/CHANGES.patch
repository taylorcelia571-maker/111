diff --git a/tianracer_gazebo/scripts/track_memory.py b/tianracer_gazebo/scripts/track_memory.py
new file mode 100644
index 0000000..67af8d5
--- /dev/null
+++ b/tianracer_gazebo/scripts/track_memory.py
@@ -0,0 +1,91 @@
+"""Immutable cyclic reference cache, available before lap one; no ROS inputs.
+
+This caches geometry and nominal speed queries, never poses, commands or safety
+decisions. Live feedback and every existing protection remain mandatory.
+"""
+import copy
+import hashlib
+import math
+import numpy as np
+
+
+class CyclicTrackMemory:
+    def __init__(self, path):
+        if path.speeds is None or not np.isfinite(path.speeds).all() or np.any(path.speeds <= 0):
+            raise ValueError('Track memory needs a complete positive speed profile')
+        if not np.isfinite(path.points).all() or not np.isfinite(path.curvature).all():
+            raise ValueError('Track memory needs finite geometry')
+        self.path = path
+        self.points, self.curvature, self.speeds = path.points, path.curvature, path.speeds
+        self.n, self.ds, self.length = path.n, path.ds, path.length
+        for array in (self.points, self.curvature, self.speeds):
+            array.setflags(write=False)
+        self.segments = np.roll(self.points, -1, axis=0) - self.points
+        self.denominator = np.maximum(np.sum(self.segments * self.segments, axis=1), 1e-9)
+        self.speed_min = self._table(self.speeds, np.minimum)
+        self.curve_max = self._table(np.abs(self.curvature), np.maximum)
+        self.geometry_sha256 = path.fingerprint()
+        self.speed_sha256 = hashlib.sha256(self.speeds.astype('<f8').tobytes()).hexdigest()
+
+    @staticmethod
+    def _table(values, reduction):
+        tables = [values]
+        span = 1
+        while span * 2 <= len(values):
+            tables.append(reduction(tables[-1], np.roll(tables[-1], -span)))
+            span *= 2
+        for array in tables:
+            array.setflags(write=False)
+        return tables
+
+    def __deepcopy__(self, memo):
+        result = type(self)(copy.deepcopy(self.path, memo))
+        memo[id(self)] = result
+        return result
+
+    def validate(self):
+        if (self.path.points is not self.points or self.path.curvature is not self.curvature or
+                self.path.speeds is not self.speeds or self.path.n != self.n or
+                self.path.ds != self.ds or self.path.length != self.length or
+                any(a.flags.writeable for a in (self.points, self.curvature, self.speeds))):
+            raise ValueError('Track memory changed; rebuild while stationary')
+
+    def _range(self, tables, index, count, reduction):
+        self.validate()
+        if not isinstance(count, (int, np.integer)) or not 0 <= count < self.n:
+            raise ValueError('Invalid cyclic track-memory query')
+        size = int(count) + 1
+        level = size.bit_length() - 1
+        span = 1 << level
+        return float(reduction(tables[level][index % self.n],
+                               tables[level][(index + size - span) % self.n]))
+
+    def minimum_speed(self, index, count):
+        return self._range(self.speed_min, index, count, min)
+
+    def maximum_curvature(self, index, count):
+        return self._range(self.curve_max, index, count, max)
+
+    def project(self, x, y, begin, end):
+        self.validate()
+        # Preserve the original projection window, clipped geometry and tie order.
+        ids = np.arange(int(math.floor(begin / self.ds)), int(math.ceil(end / self.ds)) + 1)
+        ids = ids[(ids * self.ds <= end) & ((ids + 1) * self.ds >= begin)]
+        a = self.points[ids % self.n]
+        b = self.segments[ids % self.n]
+        q = np.array([x, y]) - a
+        t = np.clip(np.sum(q * b, axis=1) / self.denominator[ids % self.n], 0, 1)
+        lower = np.clip(begin / self.ds - ids, 0, 1)
+        upper = np.clip(end / self.ds - ids, 0, 1)
+        t = np.clip(t, lower, upper)
+        projected = a + t[:, None] * b
+        d = np.linalg.norm(projected - [x, y], axis=1)
+        best = int(np.argmin(d))
+        s = float((ids[best] + t[best]) * self.ds)
+        return max(begin, min(end, s)), float(d[best])
+
+    def report(self):
+        return dict(enabled=True, warmup_laps=0, geometry_sha256=self.geometry_sha256,
+                    speed_sha256=self.speed_sha256, samples=self.n,
+                    cached='fixed projection geometry and cyclic speed/curvature range queries',
+                    replay_commands=False, live_feedback_required=True)
diff --git a/tianracer_gazebo/scripts/track_memory_audit.py b/tianracer_gazebo/scripts/track_memory_audit.py
new file mode 100755
index 0000000..5bca01f
--- /dev/null
+++ b/tianracer_gazebo/scripts/track_memory_audit.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""Offline same-budget memory/preview comparison; never launches a vehicle."""
+import argparse
+import json
+from pathlib import Path
+import statistics
+import time
+import numpy as np
+from race60_audit import load_course, rear_path
+from final_speedup_audit import BUDGETS, OPTIONS, simulate
+from predictive_follower import PredictiveFollower
+
+
+def benchmark(center):
+    ordinary = PredictiveFollower(rear_path(center), **BUDGETS, **OPTIONS)
+    cached = PredictiveFollower(rear_path(center), **BUDGETS, **dict(OPTIONS, runtime_path_cache=True))
+    path = ordinary.path
+    samples = []
+    for s in np.linspace(0., 5 * path.length, 500):
+        x, y = path.sample(s) + [.01, -.01]
+        samples.append((x, y, s - .1, s + .6))
+    query_ms = {'ordinary': [], 'cached': []}
+    for repeat in range(6):
+        # Alternate evaluation order to reduce cache/CPU warmup bias.
+        methods = [('ordinary', path.project), ('cached', cached.track_memory.project)]
+        if repeat % 2:
+            methods.reverse()
+        for name, project in methods:
+            start = time.perf_counter()
+            for sample in samples:
+                project(*sample)
+            query_ms[name].append(1000 * (time.perf_counter() - start) / len(samples))
+    return dict(projection_median_ms={k: statistics.median(v) for k, v in query_ms.items()},
+                scope='Projection only, offline wall timing; not full control cycle or lap-time gain',
+                warmup_laps_required=0)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--quick', action='store_true')
+    parser.add_argument('--route-only', action='store_true')
+    args = parser.parse_args()
+    package = Path(__file__).resolve().parents[1]
+    planner, anchors = load_course(package)
+    planner.margin = .34
+    planner.allowed = planner.clearance >= .34
+    center = planner.build(anchors, optimize_time=True, refine_line=True, line_search_level=3,
+                           response_delay=.25, speed_planning='delayed_braking', **BUDGETS)
+    print('Frozen original Level-3 route; same user71 budgets; all times are model-only.', flush=True)
+    cases = [('baseline', {}), ('memory_only', {'runtime_path_cache': True}),
+             ('adaptive_012', {'runtime_path_cache': True, 'steering_preview_mode': 'curvature_adaptive'}),
+             ('adaptive_010', {'runtime_path_cache': True, 'steering_preview_mode': 'curvature_adaptive',
+                               'steering_preview_time': .10})]
+    from joint_line_polish import polish_line
+    route_budgets = dict(BUDGETS, response_delay=.25, speed_planning='delayed_braking')
+    routes = {}
+    route_reports = []
+    for strength in (.5, 1.):
+        name = 'joint_route_' + str(strength)
+        routes[name], report = polish_line(planner, center, anchors, route_budgets, strength=strength)
+        report['name'] = name
+        route_reports.append(report)
+        print(json.dumps(report), flush=True)
+    if args.route_only:
+        cases = [('baseline', {})]
+    cases += [(name, {}) for name in routes]
+    responses = [(.08, .02, 0.), (.15, .02, 0.), (.15, .04, .04),
+                 (.25, .04, .04), (.15, .02, .12)]
+    if args.quick:
+        responses = responses[:2]
+    rows = []
+    for name, overrides in cases:
+        for lag, pose_age, joint_age in responses:
+            row = simulate(routes.get(name, center), planner, dict(OPTIONS, **overrides), lag, pose_age, joint_age)
+            row['name'] = name
+            rows.append(row)
+            print(json.dumps({k: row.get(k) for k in ('name', 'hypothetical_actuator_lag', 'pose_age',
+                'joint_transport_age', 'completed', 'total_seconds', 'peak_reference_error', 'fault')}), flush=True)
+    output = args.output.expanduser()
+    output.parent.mkdir(parents=True, exist_ok=True)
+    result = dict(official_result=False, official_under_60_verified=False, gazebo_tested=False,
+                  no_lap_time_improvement_claimed=True, route_selection=planner.selection,
+                  minimum_route_clearance=planner.segment_check(center.points),
+                  joint_route_reports=route_reports,
+                  benchmark=benchmark(center), rows=rows,
+                  assumptions='Same fixed route/budgets. Bicycle plus hypothetical first-order speed/steering lag; '
+                    'no tire dynamics, roll, AMCL jumps, laser/referee validation. '
+                    'Faster model time with worse error/drop is not acceptance evidence.')
+    output.write_text(json.dumps(result, indent=2, allow_nan=False) + '\n')
+    print('Saved model-only comparison: ' + str(output), flush=True)
+
+
+if __name__ == '__main__':
+    main()
