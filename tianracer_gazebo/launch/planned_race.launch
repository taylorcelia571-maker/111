<launch>
  <arg name="require_prepared_start" default="false"/>
  <arg name="speed_planning" default="legacy"/>
  <arg name="startup_release_early" default="false"/>
  <arg name="route_margin" default="0.34"/>
  <arg name="max_speed" default="2.0"/>
  <arg name="lateral_accel" default="5.0"/>
  <!-- Six uninterrupted reference loops allow the referee to lock five valid laps.
       Stop the controller as soon as the official result is locked. -->
  <arg name="laps" default="6"/>
  <arg name="fast_start" default="false"/>
  <arg name="optimize_time" default="false"/>
  <arg name="acceleration" default="2.0"/>
  <arg name="braking" default="3.0"/>
  <arg name="steering_rate" default="2.0"/>
  <arg name="yaw_rate" default="3.2"/>
  <arg name="start_blend" default="false"/>
  <arg name="refine_line" default="false"/>
  <arg name="predict_pose" default="false"/>
  <arg name="response_delay" default="0.25"/>
  <arg name="steering_feedback_gain" default="0.0"/>
  <arg name="steering_preview_time" default="0.10"/>
  <arg name="speed_recovery_hold" default="0.0"/>
  <arg name="line_search_level" default="0"/>
  <arg name="curvature_feedforward_gain" default="0.4"/>
  <arg name="pursuit_lookahead_scale" default="1.0"/>
  <arg name="heading_feedback_gain" default="0.8"/>
  <arg name="cross_track_gain" default="0.8"/>
  <arg name="lateral_control" default="pursuit"/>
  <arg name="run_report" default="~/ican_race_logs/control_run_report.json"/>
  <arg name="startup_speed" default="1.2"/>
  <arg name="startup_acceleration" default="1.5"/>
  <node pkg="tianracer_gazebo" type="planned_race.py" name="continuous_race"
        ns="tianracer" output="screen" required="true">
    <param name="require_prepared_start" value="$(arg require_prepared_start)" type="bool"/>
    <param name="speed_planning" value="$(arg speed_planning)"/>
    <param name="startup_release_early" value="$(arg startup_release_early)" type="bool"/>
    <param name="route_margin" value="$(arg route_margin)" type="double"/>
    <param name="max_speed" value="$(arg max_speed)" type="double"/>
    <param name="lateral_accel" value="$(arg lateral_accel)" type="double"/>
    <param name="acceleration" value="$(arg acceleration)" type="double"/>
    <param name="braking" value="$(arg braking)" type="double"/>
    <param name="steering_rate" value="$(arg steering_rate)" type="double"/>
    <param name="yaw_rate" value="$(arg yaw_rate)" type="double"/>
    <param name="response_delay" value="$(arg response_delay)" type="double"/>
    <param name="steering_feedback_gain" value="$(arg steering_feedback_gain)" type="double"/>
    <param name="steering_preview_time" value="$(arg steering_preview_time)" type="double"/>
    <param name="speed_recovery_hold" value="$(arg speed_recovery_hold)" type="double"/>
    <param name="line_search_level" value="$(arg line_search_level)" type="int"/>
    <param name="curvature_feedforward_gain" value="$(arg curvature_feedforward_gain)" type="double"/>
    <param name="pursuit_lookahead_scale" value="$(arg pursuit_lookahead_scale)" type="double"/>
    <param name="heading_feedback_gain" value="$(arg heading_feedback_gain)" type="double"/>
    <param name="cross_track_gain" value="$(arg cross_track_gain)" type="double"/>
    <param name="lateral_control" value="$(arg lateral_control)"/>
    <param name="run_report" value="$(arg run_report)"/>
    <param name="startup_speed" value="$(arg startup_speed)" type="double"/>
    <param name="startup_acceleration" value="$(arg startup_acceleration)" type="double"/>
    <param name="predict_pose" value="$(arg predict_pose)" type="bool"/>
    <param name="start_blend" value="$(arg start_blend)" type="bool"/>
    <param name="refine_line" value="$(arg refine_line)" type="bool"/>
    <param name="fast_start" value="$(arg fast_start)" type="bool"/>
    <param name="optimize_time" value="$(arg optimize_time)" type="bool"/>
    <param name="max_error" value="0.15"/>
    <param name="laps" value="$(arg laps)" type="int"/>
  </node>
</launch>
