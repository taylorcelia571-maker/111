<launch>
  <!-- New controller candidate. Budgets are assumptions pending local dynamics
       and official five-lap validation, not certified maximum vehicle limits. -->
  <arg name="max_speed" default="10.0"/>
  <arg name="lateral_accel" default="8.0"/>
  <arg name="acceleration" default="8.0"/>
  <arg name="braking" default="4.5"/>
  <arg name="yaw_rate" default="4.5"/>
  <arg name="steering_rate" default="2.0"/>
  <arg name="response_delay" default="0.25"/>
  <arg name="route_margin" default="0.34"/>
  <arg name="steering_feedback_gain" default="0.25"/>
  <arg name="startup_speed" default="1.8"/>
  <arg name="startup_acceleration" default="2.0"/>
  <arg name="startup_release_early" default="true"/>
  <arg name="laps" default="6"/>
  <arg name="run_report" default="~/ican_race_logs/time_attack_report.json"/>
  <include file="$(find tianracer_gazebo)/launch/planned_race.launch">
    <arg name="max_speed" value="$(arg max_speed)"/>
    <arg name="lateral_accel" value="$(arg lateral_accel)"/>
    <arg name="acceleration" value="$(arg acceleration)"/>
    <arg name="braking" value="$(arg braking)"/>
    <arg name="yaw_rate" value="$(arg yaw_rate)"/>
    <arg name="steering_rate" value="$(arg steering_rate)"/>
    <arg name="response_delay" value="$(arg response_delay)"/>
    <arg name="route_margin" value="$(arg route_margin)"/>
    <arg name="steering_feedback_gain" value="$(arg steering_feedback_gain)"/>
    <arg name="startup_speed" value="$(arg startup_speed)"/>
    <arg name="startup_acceleration" value="$(arg startup_acceleration)"/>
    <arg name="startup_release_early" value="$(arg startup_release_early)"/>
    <arg name="laps" value="$(arg laps)"/>
    <arg name="run_report" value="$(arg run_report)"/>
    <arg name="lateral_control" value="race_feedback"/>
    <arg name="speed_planning" value="delayed_braking"/>
    <arg name="start_blend" value="true"/>
    <arg name="fast_start" value="true"/>
    <arg name="optimize_time" value="true"/>
    <arg name="refine_line" value="true"/>
    <arg name="predict_pose" value="false"/>
  </include>
</launch>
