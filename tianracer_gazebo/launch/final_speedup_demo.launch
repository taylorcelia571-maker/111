<launch>
  <arg name="gui" default="true"/>
  <arg name="use_rviz" default="true"/>
  <arg name="with_referee" default="true"/>
  <arg name="version" default="baseline"/>
  <arg name="legacy_control" default="false"/>
  <arg name="runtime_path_cache" default="false"/>
  <arg name="steering_preview_mode" default="legacy"/>
  <arg name="route_joint_polish" default="false"/>
  <arg name="route_polish_strength" default="0.5"/>
  <arg name="route_speed_refine" default="false"/>
  <arg name="route_speed_iterations" default="6"/>
  <arg name="log_dir" default="~/ican_race_logs/final71"/>
  <arg name="lateral_accel" default="9.94"/>
  <arg name="acceleration" default="7.3"/>
  <arg name="braking" default="3.7"/>
  <arg name="yaw_rate" default="4.4"/>
  <arg name="startup_speed" default="2.0"/>
  <arg name="startup_acceleration" default="2.5"/>
  <arg name="steering_feedback_gain" default="0.25"/>
  <arg name="steering_preview_time" default="0.12"/>
  <arg name="heading_feedback_gain" default="0.8"/>
  <arg name="cross_track_gain" default="0.8"/>
  <arg name="line_search_level" default="3"/>
  <arg name="predict_pose" default="false"/>
  <arg name="startup_connector_length" default="2.5"/>
  <arg name="speed_recovery_hold" default="0.0"/>
  <arg name="require_prepared_start" default="true"/>
  <arg name="route_control_scoring" default="$(eval arg('version') == 'v2')"/>
  <include file="$(find tianracer_gazebo)/launch/planned_race_demo.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="use_rviz" value="$(arg use_rviz)"/>
  </include>
  <group if="$(arg with_referee)">
    <include file="$(find tianracer_sim_referee)/launch/referee.launch"/>
  </group>
  <include file="$(find tianracer_gazebo)/launch/final_speedup.launch">
    <arg name="runtime_path_cache" value="$(arg runtime_path_cache)"/>
    <arg name="steering_preview_mode" value="$(arg steering_preview_mode)"/>
    <arg name="route_joint_polish" value="$(arg route_joint_polish)"/>
    <arg name="route_polish_strength" value="$(arg route_polish_strength)"/>
    <arg name="route_speed_refine" value="$(arg route_speed_refine)"/>
    <arg name="route_speed_iterations" value="$(arg route_speed_iterations)"/>
    <arg name="version" value="$(arg version)"/>
    <arg name="legacy_control" value="$(arg legacy_control)"/>
    <arg name="log_dir" value="$(arg log_dir)"/>
    <arg name="lateral_accel" value="$(arg lateral_accel)"/>
    <arg name="acceleration" value="$(arg acceleration)"/>
    <arg name="braking" value="$(arg braking)"/>
    <arg name="yaw_rate" value="$(arg yaw_rate)"/>
    <arg name="startup_speed" value="$(arg startup_speed)"/>
    <arg name="startup_acceleration" value="$(arg startup_acceleration)"/>
    <arg name="steering_feedback_gain" value="$(arg steering_feedback_gain)"/>
    <arg name="steering_preview_time" value="$(arg steering_preview_time)"/>
    <arg name="heading_feedback_gain" value="$(arg heading_feedback_gain)"/>
    <arg name="cross_track_gain" value="$(arg cross_track_gain)"/>
    <arg name="line_search_level" value="$(arg line_search_level)"/>
    <arg name="predict_pose" value="$(arg predict_pose)"/>
    <arg name="startup_connector_length" value="$(arg startup_connector_length)"/>
    <arg name="speed_recovery_hold" value="$(arg speed_recovery_hold)"/>
    <arg name="require_prepared_start" value="$(arg require_prepared_start)"/>
    <arg name="route_control_scoring" value="$(arg route_control_scoring)"/>
  </include>
</launch>
