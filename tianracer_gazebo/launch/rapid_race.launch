<launch>
  <!-- Controller only: use planned_race_demo for official scene and raw bridge.
       These are tuning budgets, not certified physical vehicle limits. -->
  <!-- Share the wall reserve fix with optimized_race; do not lower the stop threshold. -->
  <arg name="route_margin" default="0.34"/>
  <arg name="laps" default="6"/>
  <arg name="run_report" default="~/ican_race_logs/control_run_report.json"/>
  <arg name="max_speed" default="5.0"/>
  <arg name="lateral_accel" default="6.0"/>
  <arg name="acceleration" default="3.0"/>
  <arg name="braking" default="3.0"/>
  <arg name="yaw_rate" default="4.0"/>
  <arg name="steering_rate" default="2.0"/>
  <arg name="response_delay" default="0.25"/>
  <arg name="steering_feedback_gain" default="0.0"/>
  <arg name="lateral_control" default="pursuit"/>
  <arg name="startup_speed" default="1.2"/>
  <arg name="startup_acceleration" default="1.5"/>
  <!-- Disabled after an observed startup tracking failure; opt in one at a time. -->
  <arg name="predict_pose" default="false"/>
  <arg name="start_blend" default="false"/>
  <arg name="refine_line" default="false"/>
  <include file="$(find tianracer_gazebo)/launch/planned_race.launch">
    <arg name="route_margin" value="$(arg route_margin)"/>
    <arg name="laps" value="$(arg laps)"/>
    <arg name="run_report" value="$(arg run_report)"/>
    <arg name="max_speed" value="$(arg max_speed)"/>
    <arg name="lateral_accel" value="$(arg lateral_accel)"/>
    <arg name="acceleration" value="$(arg acceleration)"/>
    <arg name="braking" value="$(arg braking)"/>
    <arg name="yaw_rate" value="$(arg yaw_rate)"/>
    <arg name="steering_rate" value="$(arg steering_rate)"/>
    <arg name="response_delay" value="$(arg response_delay)"/>
    <arg name="steering_feedback_gain" value="$(arg steering_feedback_gain)"/>
    <arg name="lateral_control" value="$(arg lateral_control)"/>
    <arg name="startup_speed" value="$(arg startup_speed)"/>
    <arg name="startup_acceleration" value="$(arg startup_acceleration)"/>
    <arg name="optimize_time" value="true"/>
    <arg name="fast_start" value="true"/>
    <arg name="predict_pose" value="$(arg predict_pose)"/>
    <arg name="start_blend" value="$(arg start_blend)"/>
    <arg name="refine_line" value="$(arg refine_line)"/>
  </include>
</launch>
