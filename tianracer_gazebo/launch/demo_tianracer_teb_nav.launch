<launch>
    <!-- Config map file -->
    <arg name="world" default="tianracer_racetrack" />
    <arg name="robot_name" default="$(optenv TIANRACER_NAME tianracer)" doc="robot name [tianracer_No1, tianracer_No2, tianracer_No3, ...]"/>
    <arg name="namespace" default="tianracer"/>
    <arg name="race_profile" default="false"/>
    <arg name="start_navigation" default="true"/>
    <arg name="command_watchdog" default="false"/>
    <arg name="race_max_speed" default="2.4"/>
    <arg name="planner_profile" default="false"/>
    <arg name="wheel_feedforward" default="false"/>
    <arg name="corner_speed_control" default="false"/>
    <arg name="straight_speed" default="2.0"/>
    <arg name="corner_speed" default="1.8"/>
    <arg name="corner_tuning" default="false"/>
    <arg name="path_bias" default="false"/>
    <arg name="planner_max_speed" default="2.6"/>

    <!-- rviz -->
    <group if="$(eval arg('robot_name') == '/')">

        <!-- Map server, load map-->
        <node name="map_server" pkg="map_server" type="map_server" ns="$(arg namespace)" args="$(find tianracer_gazebo)/maps/$(arg world).yaml" >
            <param name="frame_id" value="map" />
        </node>

        <!-- launch gazebo simulation environment -->
        <include file="$(find tianracer_gazebo)/launch/tianracer_on_racetrack.launch">
            <arg name="world" value="$(arg world)" />
            <arg name="robot_name" value="$(arg namespace)" />
        </include>

        <!-- launch tianracer control -->
        <include file="$(find tianracer_gazebo)/launch/tianracer_control.launch" >
            <arg name="robot_name" value="$(arg namespace)" />
            <arg name="race_profile" value="$(arg race_profile)"/>
            <arg name="race_max_speed" value="$(arg race_max_speed)"/>
                    <arg name="command_watchdog" value="$(arg command_watchdog)"/>
                    <arg name="wheel_feedforward" value="$(arg wheel_feedforward)"/>
                    <arg name="corner_speed_control" value="$(arg corner_speed_control)"/>
            <arg name="straight_speed" value="$(arg straight_speed)"/>
            <arg name="corner_speed" value="$(arg corner_speed)"/>
        </include>

        <!-- move base -->
        <include if="$(arg start_navigation)" file="$(find tianracer_gazebo)/launch/includes/teb_base.launch.xml" >
            <arg name="robot_name" value="$(arg namespace)" />
            <arg name="race_profile" value="$(arg race_profile)"/>
            <arg name="race_max_speed" value="$(arg race_max_speed)"/>
                    <arg name="planner_profile" value="$(arg planner_profile)"/>
            <arg name="planner_max_speed" value="$(arg planner_max_speed)"/>
                    <arg name="corner_tuning" value="$(arg corner_tuning)"/>
            <arg name="path_bias" value="$(arg path_bias)"/>
        </include>

        <!-- AMCL -->
        <include file="$(find tianracer_gazebo)/launch/includes/amcl.launch.xml" >
            <arg name="robot_name" value="$(arg namespace)" />
        </include>

        <node pkg="rviz" type="rviz" name="rviz" args="-d $(find tianracer_gazebo)/rviz/nav.rviz"/>
    </group>

    <group unless="$(eval arg('robot_name') == '/')">

        <!-- Map server, load map-->
        <node name="map_server" pkg="map_server" type="map_server" ns="$(arg robot_name)" args="$(find tianracer_gazebo)/maps/$(arg world).yaml" >
            <param name="frame_id" value="map" />
        </node>

        <!-- launch gazebo simulation environment -->
        <include file="$(find tianracer_gazebo)/launch/tianracer_on_racetrack.launch">
            <arg name="world" value="$(arg world)" />
            <arg name="robot_name" value="$(arg robot_name)" />
        </include>

        <!-- spawn model-->
        <!-- <include file="$(find tianracer_gazebo)/launch/spawn_model.launch" /> -->

        <!-- launch tianracer control -->
        <include file="$(find tianracer_gazebo)/launch/tianracer_control.launch" >
            <arg name="robot_name" value="$(arg robot_name)" />
            <arg name="race_profile" value="$(arg race_profile)"/>
            <arg name="race_max_speed" value="$(arg race_max_speed)"/>
                    <arg name="command_watchdog" value="$(arg command_watchdog)"/>
                    <arg name="wheel_feedforward" value="$(arg wheel_feedforward)"/>
                    <arg name="corner_speed_control" value="$(arg corner_speed_control)"/>
            <arg name="straight_speed" value="$(arg straight_speed)"/>
            <arg name="corner_speed" value="$(arg corner_speed)"/>
        </include>

        <!-- move base -->
        <include if="$(arg start_navigation)" file="$(find tianracer_gazebo)/launch/includes/teb_base.launch.xml" >
            <arg name="robot_name" value="$(arg robot_name)" />
            <arg name="race_profile" value="$(arg race_profile)"/>
            <arg name="race_max_speed" value="$(arg race_max_speed)"/>
                    <arg name="planner_profile" value="$(arg planner_profile)"/>
            <arg name="planner_max_speed" value="$(arg planner_max_speed)"/>
                    <arg name="corner_tuning" value="$(arg corner_tuning)"/>
            <arg name="path_bias" value="$(arg path_bias)"/>
        </include>

        <!-- AMCL -->
        <include file="$(find tianracer_gazebo)/launch/includes/amcl.launch.xml" >
            <arg name="robot_name" value="$(arg robot_name)" />
        </include>

        <node pkg="rviz" type="rviz" name="rviz" args="-d $(find tianracer_gazebo)/rviz/nav_$(arg robot_name).rviz"/>
    </group>

</launch>
