<launch>
  <!-- Experimental capability budgets. Not a verified <60s official result. -->
  <arg name="max_speed" default="8.0"/>
  <arg name="lateral_accel" default="9.0"/>
  <arg name="acceleration" default="6.0"/>
  <arg name="braking" default="6.0"/>
  <arg name="yaw_rate" default="5.5"/>
  <include file="$(find tianracer_gazebo)/launch/rapid_race.launch">
    <arg name="max_speed" value="$(arg max_speed)"/>
    <arg name="lateral_accel" value="$(arg lateral_accel)"/>
    <arg name="acceleration" value="$(arg acceleration)"/>
    <arg name="braking" value="$(arg braking)"/>
    <arg name="yaw_rate" value="$(arg yaw_rate)"/>
  </include>
</launch>
