<launch>
  <arg name="straight_speed" default="2.0"/>
  <arg name="corner_speed" default="1.8"/>
  <arg name="corner_tuning" default="false"/>
  <include file="$(find tianracer_gazebo)/launch/demo_tianracer_teb_nav.launch">
    <arg name="world" value="tianracer_racetrack"/>
    <arg name="robot_name" value="tianracer"/>
    <arg name="planner_profile" value="true"/>
    <arg name="planner_max_speed" value="$(arg straight_speed)"/>
    <arg name="race_profile" value="false"/>
    <arg name="command_watchdog" value="true"/>
    <arg name="wheel_feedforward" value="true"/>
    <arg name="corner_speed_control" value="true"/>
    <arg name="straight_speed" value="$(arg straight_speed)"/>
    <arg name="corner_speed" value="$(arg corner_speed)"/>
    <arg name="corner_tuning" value="$(arg corner_tuning)"/>
    <arg name="path_bias" value="false"/>
  </include>
</launch>
