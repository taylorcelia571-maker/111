<launch>
  <!-- Bounded C2 merging, exercised with the original Gazebo vehicle.
       Reference-loop tests are not certified official five-lap results. -->
  <arg name="laps" default="6"/>
  <arg name="run_report" default="~/ican_race_logs/control_run_report.json"/>
  <arg name="steering_feedback_gain" default="0.0"/>
  <include file="$(find tianracer_gazebo)/launch/rapid_race.launch">
    <arg name="laps" value="$(arg laps)"/>
    <arg name="run_report" value="$(arg run_report)"/>
    <arg name="max_speed" value="10.0"/>
    <arg name="lateral_accel" value="6.5"/>
    <arg name="acceleration" value="5.5"/>
    <arg name="braking" value="3.0"/>
    <arg name="yaw_rate" value="3.8"/>
    <arg name="route_margin" value="0.34"/>
    <arg name="lateral_control" value="smooth_pursuit"/>
    <arg name="start_blend" value="true"/>
    <arg name="startup_speed" value="1.8"/>
    <arg name="startup_acceleration" value="2.0"/>
    <arg name="steering_feedback_gain" value="$(arg steering_feedback_gain)"/>
    <arg name="response_delay" value="0.25"/>
    <arg name="predict_pose" value="false"/>
    <arg name="refine_line" value="false"/>
  </include>
</launch>
